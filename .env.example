# Copy into PRIVATE Hostinger settings or an ignored .env.local. Never commit real values.
APP_URL=https://horizony.store
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=8
# Optional provider CA certificate (PEM). Certificate verification stays enabled.
DATABASE_CA_CERT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_100=
STRIPE_PRICE_1495=
STRIPE_PRICE_2995=
STRIPE_PRICE_4495=
STRIPE_PRICE_5995=
# Keep both false until database migration, admin setup, test payments and webhooks pass.
CHECKOUT_ENABLED=false
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Optional ISO 3166-1 alpha-2 override; otherwise the owner-approved European list + US/CA/AU/GB is used.
SHIPPING_COUNTRIES=AL,AD,AM,AT,AZ,BY,BE,BA,BG,HR,CY,CZ,DK,EE,FI,FR,GE,DE,GR,HU,IS,IE,IT,KZ,XK,LV,LI,LT,LU,MT,MD,MC,ME,NL,MK,NO,PL,PT,RO,RU,SM,RS,SK,SI,ES,SE,CH,TR,UA,GB,VA,US,CA,AU
